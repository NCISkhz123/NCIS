{
  "name": "ncis-cssd-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    ".local:prepare": "tsx scripts/local-dev.ts prepare",
    ".local:quick": "tsx scripts/local-dev.ts quick",
    ".local:clean": "tsx scripts/local-dev.ts clean",
    "local:start": "npm run .local:quick",
    "local:app": "npm run dev",
    "local:clean": "npm run .local:clean",
    "local:quick": "npm run local:start && npm run local:app",
    "local:dev": "npm run .local:prepare && npm run dev",
    "local:fix": "npm run local:clean && npm run local:dev",
    "auth:bootstrap-demo": "tsx scripts/bootstrap-demo-auth.ts",
    "supabase:start": "supabase start -x realtime,storage-api,postgres-meta,studio,imgproxy,mailpit,vector,logflare,edge-runtime,supavisor",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "pnpm exec vitest run tests/unit --passWithNoTests --pool=threads --no-file-parallelism --maxWorkers=1",
    "test:unit:compat": "pnpm exec vitest run tests/unit --passWithNoTests --pool=forks --no-file-parallelism --maxWorkers=1",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test": "npm run test:unit",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@next/env": "^16.2.9",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "leaflet-geosearch": "^4.4.0",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "react-leaflet": "^5.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "supabase": "^2.108.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
